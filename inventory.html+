<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PrepTrack | Next-Gen Inventory</title>
    <link rel="stylesheet" href="inventory.css">

    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-database-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
</head>
<body>

    <div class="sys-bar" style="display: flex; justify-content: space-between; align-items: center; padding: 10px 20px; background: #09090b; border-bottom: 1px solid #27272a; font-size: 0.85rem; color: #a1a1aa; font-family: system-ui, sans-serif;">
        <div><a href="index.html" style="color: #a1a1aa; text-decoration: none; font-weight: 600;">⬅ Master Hub</a></div>
        <div class="sync-status" style="display: flex; align-items: center;">
            <div id="sync-indicator" style="width: 8px; height: 8px; border-radius: 50%; background: #3b82f6; margin-right: 8px; box-shadow: 0 0 5px #3b82f6;"></div>
            <span id="sync-text">Connecting...</span>
            <span style="margin: 0 10px;">|</span> 📍 <span id="loc-display">Loading...</span> 
            <span style="margin: 0 10px;">|</span> 👤 <span id="user-display">Loading...</span>
        </div>
    </div>

    <div class="app-container">
        <aside class="sidebar">
            <div class="logo-container">
                <h2>PrepTrack</h2>
            </div>
            <nav class="nav-menu">
                <a href="#dashboard" class="nav-item active">Dashboard Overview</a>
                <a href="#inventory" class="nav-item">Stock Tracker</a>
                <a href="#waste" class="nav-item">Waste Log</a>
                <a href="#suppliers" class="nav-item">Suppliers</a>
            </nav>
        </aside>

        <main class="main-content">
            
            <header class="top-header">
                <h1>Live Dashboard</h1>
                <div class="quick-actions">
                    <button id="btn-receive-delivery" class="btn btn-primary">+ Receive Delivery / Add Item</button>
                    <button class="btn btn-secondary">Export Report</button>
                </div>
            </header>

            <div id="dashboard" class="tab-content active-tab">
                <section class="summary-cards">
                    <div class="card">
                        <h3>Total Inventory Value</h3>
                        <p class="card-value" id="total-value">$0.00</p>
                    </div>
                    <div class="card">
                        <h3>Items Low on Stock</h3>
                        <p class="card-value alert-text" id="low-stock-count">0</p>
                    </div>
                    <div class="card">
                        <h3>Recent Waste (This Week)</h3>
                        <p class="card-value" id="waste-value">$0.00</p>
                    </div>
                </section>
            </div>

            <div id="inventory" class="tab-content">
                <section class="inventory-section">
                    <div class="section-header">
                        <h2>Dynamic Stock Tracker</h2>
                        <input type="text" id="search-input" placeholder="Search items..." class="search-bar">
                    </div>
                    <div class="table-container">
                        <table class="inventory-table">
                            <thead>
                                <tr>
                                    <th>Item Name</th>
                                    <th>Category</th>
                                    <th>Quantity</th>
                                    <th>Unit Cost</th>
                                    <th>Total Value</th>
                                    <th>Status</th>
                                    <th>Quick Usage</th>
                                </tr>
                            </thead>
                            <tbody id="inventory-body">
                                </tbody>
                        </table>
                    </div>
                </section>
            </div>

            <div id="waste" class="tab-content">
                <section class="waste-log-section panel-section" style="max-width: 600px;">
                    <h2>Log Waste</h2>
                    <form id="waste-form" class="waste-form">
                        <div class="form-group">
                            <label for="waste-item">Item</label>
                            <select id="waste-item" required>
                                <option value="" disabled selected>Select an item...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="waste-qty">Quantity Lost</label>
                            <input type="number" id="waste-qty" min="0.1" step="0.1" required>
                        </div>
                        <div class="form-group">
                            <label for="waste-reason">Reason</label>
                            <input type="text" id="waste-reason" placeholder="e.g., Dropped, Expired" required>
                        </div>
                        <button type="submit" class="btn btn-alert w-100">Record Loss</button>
                    </form>
                </section>
            </div>

            <div id="suppliers" class="tab-content">
                <section class="suppliers-section panel-section" style="max-width: 600px;">
                    <h2>Quick Suppliers</h2>
                    <ul class="supplier-list" id="supplier-list">
                        </ul>
                </section>
            </div>

        </main>
    </div>

    <div id="delivery-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal" id="close-delivery">&times;</span>
            <h2>Receive Delivery / Add Item</h2>
            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 20px;">
                Type an existing item to update stock and price, or type a new name to create one.
            </p>
            <form id="delivery-form">
                <div class="form-group">
                    <label for="del-name">Item Name</label>
                    <input type="text" id="del-name" list="existing-items" placeholder="e.g., Roma Tomatoes..." required>
                    <datalist id="existing-items">
                        </datalist>
                </div>
                <div class="form-group">
                    <label for="del-category">Category</label>
                    <select id="del-category" required>
                        <option value="Produce">Produce</option>
                        <option value="Dairy">Dairy</option>
                        <option value="Dry Goods">Dry Goods</option>
                        <option value="Meat">Meat</option>
                        <option value="Beverage">Beverage</option>
                    </select>
                </div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="del-qty">Qty Received</label>
                        <input type="number" id="del-qty" min="0.1" step="0.1" required>
                    </div>
                    <div class="form-group">
                        <label for="del-unit">Unit (e.g., lbs)</label>
                        <input type="text" id="del-unit" required>
                    </div>
                </div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="del-cost">New Unit Cost ($)</label>
                        <input type="number" id="del-cost" min="0.01" step="0.01" required>
                    </div>
                    <div class="form-group">
                        <label for="del-threshold">Low Stock Alert At</label>
                        <input type="number" id="del-threshold" min="1" step="1" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100">Process Delivery</button>
            </form>
        </div>
    </div>

    <script src="inventory.js"></script>
</body>
</html>
